# ---------------------------------------------------------------------------
#  moremontessori.ru — конфигурация Apache на хостинге Beget
# ---------------------------------------------------------------------------

Options -Indexes

<FilesMatch "^(config\.php|config\.sample\.php|\.gitignore|\.htaccess|.*\.log|.*\.md)$">
    Require all denied
</FilesMatch>

RedirectMatch 404 /\.git

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Проверку Let's Encrypt не трогаем никогда
    RewriteRule ^\.well-known/ - [L]

    # Редирект на HTTPS включает тумблер в панели Beget, не здесь

    # Без www (не трогаем технические адреса *.beget.tech)
    RewriteCond %{HTTP_HOST} !\.beget\.tech$ [NC]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
        application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg             "access plus 30 days"
    ExpiresByType image/png              "access plus 30 days"
    ExpiresByType image/svg+xml          "access plus 30 days"
    ExpiresByType video/mp4              "access plus 30 days"
    ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

AddDefaultCharset UTF-8
